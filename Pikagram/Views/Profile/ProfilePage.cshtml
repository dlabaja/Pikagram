@{
    ViewData["Title"] = ViewBag.User.UserName;
}

@{
    List<Like> likes = ViewBag.Likes;
    List<Post>? posts = (List<Post>?)ViewBag.Posts ?? (List<Post>?)ViewBag.LikedPosts;
    List<Comment>? comments = (List<Comment>?)ViewBag.Comments ?? (List<Comment>?)ViewBag.LikedComments;
    var isMe = User.Identity?.Name == ViewBag.User.UserName;
    var followText = ViewBag.IsFollowing ? "Přestat sledovat" : "Sledovat";
}

<div class="profile__container">
    <img src="@ViewBag.User.BackgroundSrc" class="profile__background"/>
    <div class="profile__lower">
        <img src="@ViewBag.User.AvatarSrc" class="profile__avatar"/>
        <div class="profile__gap"></div>
        <div class="profile__name">
            <h1>
                @ViewBag.User.FirstName @ViewBag.User.LastName
                @if (isMe)
                {
                    <span>(to jsem já)</span>
                }
            </h1>
            <h2>@@@ViewBag.User.UserName</h2>
            <div>
                @if (!isMe && User.Identity?.Name != null)
                {
                    <button
                        id="follow-@ViewBag.User.Id"
                        value="@ViewBag.IsFollowing.ToString().ToLower()"
                        onclick="onToggleFollow('@ViewBag.User.Id', 'follow-@ViewBag.User.Id')"
                    >
                        @followText
                    </button>
                }
                <a href="/profile/@ViewBag.User.UserName/followers">@ViewBag.FollowerCount sledujících</a>
                <a href="/profile/@ViewBag.User.UserName/following">@ViewBag.FollowingCount sleduje</a>
            </div>
        </div>
    </div>
    <span>@ViewBag.User.Bio</span>
    <div class="profile__content">
        <div>
            <select id="profile-select"
                    onchange="window.location.href = `${window.location.pathname}?tab=${this.value}`">
                <option value="1">Příspěvky</option>
                <option value="2">Oblíbené příspěvky</option>
                <option value="3">Komentáře</option>
                <option value="4">Oblíbené komentáře</option>
            </select>
        </div>
        @if (posts != null)
        {
            <div class="profile__posts">
                @foreach (var post in posts)
                {
                    <partial name="Components/_PostPreview" model="@(post, likes)"/>
                }
            </div>
        }
        else if (comments != null)
        {
            foreach (var comment in comments)
            {
                <partial name="Components/_Comment" model="@(comment, likes)"/>
            }
        }
    </div>
</div>
<script>
    const tab = new URLSearchParams(window.location.search).get("tab");
    const element = document.getElementById("profile-select")
    if (tab) {
        element.value = tab;
    }
</script>
<style>
    .profile__container {
        width: 100%;
    }

    .profile__background {
        height: 200px;
        width: 100%;
        object-fit: cover;
        border: 1px solid black;
        border-radius: 8px;
    }

    .profile__avatar {
        border: 1px solid black;
        border-radius: 50%;
        object-fit: cover;
        max-width: 200px;
        position: absolute;
        top: -50px;
    }

    .profile__gap {
        width: 230px;
    }

    .profile__lower {
        position: relative;
        width: fit-content;
        display: flex;
        margin: auto;
        height: 200px;
    }

    .profile__posts {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }

    .profile__content {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
</style>