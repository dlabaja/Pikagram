@{
    List<Guid> userFollowing = ViewBag.UserFollowing;
    List<User> followers = ViewBag.Followers;
    string username = ViewBag.Username;
}

<div>
    <h1>Kdo sleduje @@@username</h1>
    @foreach (var user in followers)
    {
        <partial name="Components/_User" model="(user, userFollowing)"/>
    }
</div>