@model (Comment comment, List<Like> likes)

@{
    var user = User.Identity?.Name;
    var likedSrc = "/assets/icons/like-filled.png";
    var unlikedSrc = "/assets/icons/like.png";
    var isLiked = Model.likes.FirstOrDefault(x => x.LikedId == Model.comment.Id) != null;
    var initLikeSrc = isLiked ? likedSrc : unlikedSrc;
}

<div class="comment_container">
    <div class="comment__header">
        <div class="comment__author">
            <img src="@Model.comment.Author.AvatarSrc" class="comment__avatar"/>
            <a asp-controller="Profile" asp-action="@Model.comment.Author.UserName">
                <p>@@@Model.comment.Author.UserName</p>
            </a>
        </div>
        <div>
            <div class="comment__interaction">
                @if (user != null)
                {
                    <button
                        id="comment-like-@Model.comment.Id"
                        value="@isLiked.ToString().ToLower()"
                        onclick="onToggleLikeComment('comment-like-@Model.comment.Id', '@Model.comment.Id')"
                    >
                        <img src="@initLikeSrc" class="comment__interaction-img"/>
                    </button>
                }
                @if (Model.comment.Author.UserName == User.Identity?.Name)
                {
                    <button onclick="postAndRefresh('/api/comments/@Model.comment.Id/delete')">
                        <img src="/assets/icons/remove.png" class="comment__interaction-img"/>
                    </button>
                }
            </div>
        </div>
    </div>
    <small>@Model.comment.DatePublished.ToString("dd. MM. yyyy")</small>
    <p>@Model.comment.Text</p>
</div>