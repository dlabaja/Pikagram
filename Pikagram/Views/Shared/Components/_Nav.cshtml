<nav class="nav">
    @{
        var list = new List<(string controller, string action, string icon)>
        {
            ("Home", "Index", "home.png"),
            ("Search", "Index", "search.png")
        };
        if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            list.Add(("Posts", "Create", "publish.png"));
            list.Add(("Profile", User.Identity.Name!, "profile.png"));
        }
    }
    @foreach(var item in list)
    {
        <a asp-controller=@item.controller asp-action=@item.action>
            <img src=@($"/assets/icons/{item.icon}") alt="nav icon" class="nav__img"/>
        </a>
    }
</nav>
<style>
    .nav {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
    }
    
    .nav__img {
        height: 32px;
    }
</style>