@using Pikagram.Enums
@model (Post post, List<Like> likes)

@{
    var user = User.Identity?.Name;
    var likedSrc = "/assets/icons/like-filled.png";
    var unlikedSrc = "/assets/icons/like.png";
    var isLiked = Model.likes.FirstOrDefault(x => x.LikedId == Model.post.Id) != null;
    var initLikeSrc = isLiked ? likedSrc : unlikedSrc;
}

<div class="post__container" id="@Model.post.Id">
    <a href="/posts/@Model.post.Id" class="post__media-container">
    @if (Model.post.MediaType == MediaType.Image)
    {
        <img src="@Model.post.MediaSrc" alt="post" class="post__media"/>
    }
    else
    {
        <video src="@Model.post.MediaSrc" class="post__media"></video>
    }
    </a>
    <div class="post__interaction">
        @if (user != null)
        {
            <button id="like-@Model.post.Id" value="@isLiked.ToString().ToLower()"
                    onclick="onToggleLikePost('like-@Model.post.Id', '@Model.post.Id')">
                <img src="@initLikeSrc" class="post__interaction-img"/>
            </button>
        }
        @if (Model.post.Author.UserName == User.Identity?.Name)
        {
            <a href="/posts/@Model.post.Id/edit">
                <button id="edit-@Model.post.Id">
                    <img src="/assets/icons/edit.png" class="post__interaction-img"/>
                </button>
            </a>
            <form method="post" action="/posts/@Model.post.Id/delete">
                <button type="submit">
                    <img src="/assets/icons/remove.png" class="post__interaction-img"/>
                </button>
            </form>
        }
    </div>
</div>
