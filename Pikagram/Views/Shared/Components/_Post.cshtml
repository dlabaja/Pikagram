@using Pikagram.Enums
@model Post

@{
    var commentRoute = $"/posts/{Model.Id}/comment";
    var likedSrc = "/assets/icons/like-filled.png";
    var unlikedSrc = "/assets/icons/like.png";
}

<div class="post__container" id="@Model.Id">
    <div class="post__media-container">
        @if (Model.MediaType == MediaType.Image)
        {
            <img src="@Model.MediaSrc" alt="post" class="post__media"/>
        }
        else
        {
            <video src="@Model.MediaSrc" class="post__media"></video>
        }
        <div class="post__interaction">
            <button>
                <img src="@unlikedSrc" class="post__interaction-img"/>
            </button>
            @if (Model.Author.UserName == User.Identity?.Name)
            {
                <button>
                    <img src="/assets/icons/edit.png" class="post__interaction-img"/>
                </button>
                <button>
                    <img src="/assets/icons/remove.png" class="post__interaction-img"/>
                </button>
            }
        </div>
    </div>
    <div class="post__content">
        <div class="post__author">
            <img src="@Model.Author.AvatarSrc" class="post__avatar"/>
            <a asp-controller="Profile" asp-action="@Model.Author.UserName">
                <p>@@@Model.Author.UserName</p>
            </a>
        </div>
        <small>@Model.DatePublished.ToString("dd. MM. yyyy")</small>
        <p>@Model.Text</p>
        <p>@Model.FormatTags()</p>
        <form class="post__comment-form" method="post" action="@commentRoute">
            <textarea name="Content" placeholder="Sem napište komentář" required></textarea>
            <div>
                <button type="submit">Okomentovat</button>
            </div>
        </form>
        <div class="post__comments">
            @foreach (var comment in Model.Comments)
            {
                <partial name="Components/_Comment" model="comment"/>
            }
        </div>
    </div>
</div>
<style>
    .post__container {
        display: flex;
        border: 1px solid black;
        width: 100%;
        height: 700px;
        max-width: 1000px;
        border-radius: 12px;
    }

    .post__media-container {
        position: relative;
        display: flex;
        height: 100%;
        min-width: 60%;
        max-width: 600px;
    }

    .post__media {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px 0 0 12px;
    }

    .post__content {
        display: flex;
        flex-direction: column;
        width: 100%;
        padding: 8px;
    }

    .post__author {
        display: flex;
        align-items: center;
    }

    .post__avatar {
        width: 30px;
        height: 30px;
        object-fit: contain;
        border-radius: 50%;
    }

    .post__comment-form {
        display: flex;
        flex-direction: column;
    }

    .post__comments {
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow: auto;
    }

    .post__interaction {
        position: absolute;
        bottom: 0;
        right: 0;
        padding: 8px;
    }

    .post__interaction-img {
        width: 40px;
        height: 40px;
    }

    @@media (max-width: 700px) {
        .post__container {
            flex-direction: column;
        }

        .post__media {
            height: 500px;
            border-radius: 12px 12px 0 0;
        }

        .post__content {
            overflow: auto;
        }

        .post__comments {
            overflow: unset;
        }
    }
</style>
