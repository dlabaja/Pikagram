@using Pikagram.Enums
@model (Post post, List<Like> likes)

@{
    var commentRoute = $"/posts/{Model.post.Id}/comment";
    var user = User.Identity?.Name;
    var likedSrc = "/assets/icons/like-filled.png";
    var unlikedSrc = "/assets/icons/like.png";
    var isLiked = Model.likes.FirstOrDefault(x => x.LikedId == Model.post.Id) != null;
    var initLikeSrc = isLiked ? likedSrc : unlikedSrc;
}

<div class="post__container" id="@Model.post.Id">
    <div class="post__media-container">
        @if (Model.post.MediaType == MediaType.Image)
        {
            <img src="@Model.post.MediaSrc" alt="post" class="post__media"/>
        }
        else
        {
            <video src="@Model.post.MediaSrc" class="post__media"></video>
        }
        <div class="post__interaction">
            @if (user != null)
            {
                <button id="like-@Model.post.Id" value="@isLiked.ToString().ToLower()" onclick="onToggleLikePost('like-@Model.post.Id', '@Model.post.Id')">
                    <img src="@initLikeSrc" class="post__interaction-img"/>
                </button>
            }
            @if (Model.post.Author.UserName == User.Identity?.Name)
            {
                <button id="edit-@Model.post.Id">
                    <img src="/assets/icons/edit.png" class="post__interaction-img"/>
                </button>
                <form method="post" action="/posts/@Model.post.Id/delete">
                    <button type="submit">
                        <img src="/assets/icons/remove.png" class="post__interaction-img"/>
                    </button>
                </form>
            }
        </div>
    </div>
    <div class="post__content">
        <div class="post__author">
            <img src="@Model.post.Author.AvatarSrc" class="post__avatar"/>
            <a asp-controller="Profile" asp-action="@Model.post.Author.UserName">
                <p>@@@Model.post.Author.UserName</p>
            </a>
        </div>
        <small>@Model.post.DatePublished.ToString("dd. MM. yyyy")</small>
        <p>@Model.post.Text</p>
        <p>@Model.post.FormatTags()</p>
        @if (User.Identity?.Name != null)
        {
            <form class="post__comment-form" method="post" action="@commentRoute">
                <textarea name="Content" placeholder="Sem napište komentář" required></textarea>
                <div>
                    <button type="submit">Okomentovat</button>
                </div>
            </form>
        }
        <div class="post__comments">
            @foreach (var comment in Model.post.Comments)
            {
                <partial name="Components/_Comment" model="@(comment, Model.likes)"/>
            }
        </div>
    </div>
</div>
<style>
    .post__container {
        display: flex;
        border: 1px solid black;
        width: 100%;
        height: 700px;
        max-width: 1000px;
        border-radius: 12px;
    }

    .post__media-container {
        position: relative;
        display: flex;
        height: 100%;
        min-width: 60%;
        max-width: 600px;
    }

    .post__media {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px 0 0 12px;
    }

    .post__content {
        display: flex;
        flex-direction: column;
        width: 100%;
        padding: 8px;
    }

    .post__author {
        display: flex;
        align-items: center;
    }

    .post__avatar {
        width: 30px;
        height: 30px;
        object-fit: contain;
        border-radius: 50%;
    }

    .post__comment-form {
        display: flex;
        flex-direction: column;
    }

    .post__comments {
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow: auto;
    }

    .post__interaction {
        position: absolute;
        display: flex;
        bottom: 0;
        right: 0;
        padding: 8px;
    }

    .post__interaction-img {
        width: 40px;
        height: 40px;
    }

    @@media (max-width: 700px) {
        .post__container {
            flex-direction: column;
        }

        .post__media {
            height: 500px;
            border-radius: 12px 12px 0 0;
        }

        .post__content {
            overflow: auto;
        }

        .post__comments {
            overflow: unset;
        }
    }
</style>
