@* validace přes PageModel *@
@model Pikagram.Views.Account.LoginModel
@{
    ViewData["Title"] = "Přihlášení";
}

@* pošle se page modelu, ten to verifikuje a upraví v userManageru *@
<form method="post">
    <div asp-validation-summary="ModelOnly"></div>
    
    <label asp-for="Input.Username">Přezdívka</label>
    <input type="text" asp-for="Input.Username" required/>
    <span asp-validation-for="Input.Username"></span>

    <label asp-for="Input.Password">Heslo</label>
    <input type="password" asp-for="Input.Password" required/>
    <span asp-validation-for="Input.Password"></span>

    <input type="submit" value="Přihlásit se">
</form>
<p>Nemáš ještě účet? Tak se <a asp-controller="Account" asp-action="Register">zaregistruj!</a></p>