@model Pikagram.Views.Account.RegisterModel
@{
    ViewData["Title"] = "Registrace";
}

<h1>Registrace</h1>
<form method="post" class="form">
    <div class="input-container">
        <input type="text" asp-for="Input.FirstName" placeholder="Jméno" required/>
        <input type="text" asp-for="Input.LastName" placeholder="Příjmení" required/>
    </div>

    <div class="input-container">
        <input type="email" asp-for="Input.Email" placeholder="Email" required/>
        <input type="text" asp-for="Input.Username" placeholder="Přezdívka" required/>
    </div>

    <div class="input-container">
        <input type="password" asp-for="Input.Password" placeholder="Heslo" required/>
        <input type="password" asp-for="Input.ConfirmPassword" placeholder="Heslo 2: Electric Boogaloo" required/>
    </div>

    <div>
        <input type="checkbox" asp-for="Input.PrivacyPolicy"/>
        <label asp-for="Input.PrivacyPolicy">Souhlasím se <a asp-controller="Privacy" asp-action="Index">zpracováním osobních údajů</a></label>
    </div>

    <div>
        <input type="checkbox" asp-for="Input.SonChecked" required/>
        <label asp-for="Input.SonChecked">Souhlasím, že obětuji svého prvorozeného syna jazyku C</label>
    </div>

    <div>
        <input type="checkbox" asp-for="Input.AnanasChecked" required/>
        <label asp-for="Input.AnanasChecked">Souhlasím, že ananas na pizzu patří</label>
    </div>

    <div asp-validation-summary="All"></div>
    <input type="submit" value="Registrovat">
</form>
