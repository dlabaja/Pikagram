@model Pikagram.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registrace";
}

<h1>Registrace</h1>
<form method="post" class="form">
    <div class="input-container">
        <input type="text" asp-for="FirstName" placeholder="Jméno (klidně imaginární)" required/>
        <input type="text" asp-for="LastName" placeholder="Příjmení (klidně cizí)" required/>
    </div>

    <div class="input-container">
        <input type="email" asp-for="Email" placeholder="Email (klidně falešnej)" required/>
        <input type="text" asp-for="Username" placeholder="Přezdívka" required/>
    </div>

    <div class="input-container">
        <input type="password" asp-for="Password" placeholder="Heslo" required/>
        <input type="password" asp-for="ConfirmPassword" placeholder="Heslo 2: Electric Boogaloo" required/>
    </div>

    <div>
        <input type="checkbox" asp-for="PrivacyPolicy"/>
        <label asp-for="PrivacyPolicy">Souhlasím se <a asp-controller="Privacy" asp-action="Index">zpracováním osobních údajů</a></label>
    </div>

    <div>
        <input type="checkbox" asp-for="SonChecked" required/>
        <label asp-for="SonChecked">Souhlasím, že obětuji svého prvorozeného syna jazyku C</label>
    </div>

    <div>
        <input type="checkbox" asp-for="AnanasChecked" required/>
        <label asp-for="AnanasChecked">Souhlasím, že ananas na pizzu patří</label>
    </div>

    <input type="submit" value="Registrovat">
</form>
<div asp-validation-summary="All"></div>
