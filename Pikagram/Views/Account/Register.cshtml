@model Pikagram.Views.Account.RegisterModel
@{
    ViewData["Title"] = "Registrace";
}

<form method="post">
    <label asp-for="Input.FirstName">Jméno</label>
    <input type="text" asp-for="Input.FirstName" required/>
    
    <label asp-for="Input.LastName">Příjmení</label>
    <input type="text" asp-for="Input.LastName" required/>

    <label asp-for="Input.Email">Email</label>
    <input type="text" asp-for="Input.Email" required/>

    <label asp-for="Input.Username">Přezdívka</label>
    <input type="text" asp-for="Input.Username" required/>
    
    <label asp-for="Input.DateBorn">Datum narození</label>
    <input type="date" asp-for="Input.DateBorn" required/>

    <label asp-for="Input.Password">Heslo</label>
    <input type="password" asp-for="Input.Password" required/>

    <label asp-for="Input.ConfirmPassword">Heslo 2: Electric Boogaloo</label>
    <input type="password" asp-for="Input.ConfirmPassword" required/>

    <label asp-for="Input.PrivacyPolicy">Souhlasím se <a asp-controller="Privacy" asp-action="Index">zpracováním osobních údajů</a></label>
    <input type="checkbox" asp-for="Input.PrivacyPolicy"/>

    <label asp-for="Input.SonChecked">Souhlasím, že obětuji svého prvorozeného syna jazyku C</label>
    <input type="checkbox" asp-for="Input.SonChecked" required/>

    <label asp-for="Input.AnanasChecked">Souhlasím, že ananas na pizzu patří</label>
    <input type="checkbox" asp-for="Input.AnanasChecked" required/>

    <input type="submit" value="Registrovat">
</form>