@model Pikagram.Views.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Změna hesla";
}

<form>
    <label asp-for="Input.OldPassword">Staré heslo</label>
    <input type="password" asp-for="Input.OldPassword" required/>
    
    <label asp-for="Input.NewPassword">Nové heslo</label>
    <input type="password" asp-for="Input.NewPassword" required/>

    <label asp-for="Input.ConfirmPassword">Potvrďte heslo</label>
    <input type="password" asp-for="Input.ConfirmPassword" required/>

    <input type="submit" value="Změnit heslo">
</form>