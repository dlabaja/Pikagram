@model Pikagram.ViewModels.ChangePasswordModel
@{
    ViewData["Title"] = "Změna hesla";
}

<h1>Změnit heslo</h1>
<form method="post" class="form">
    <input type="password" asp-for="OldPassword" placeholder="Staré heslo" required/>

    <input type="password" asp-for="NewPassword" placeholder="Nové heslo" required/>

    <input type="password" asp-for="ConfirmPassword" placeholder="Potvrď heslo" required/>

    <input type="submit" value="Změnit heslo">
</form>
<div asp-validation-summary="All"></div>