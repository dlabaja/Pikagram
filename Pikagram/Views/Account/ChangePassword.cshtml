@model Pikagram.ViewModels.ChangePasswordModel
@{
    ViewData["Title"] = "Změna hesla";
}

<form>
    <label asp-for="OldPassword">Staré heslo</label>
    <input type="password" asp-for="OldPassword" required/>

    <label asp-for="NewPassword">Nové heslo</label>
    <input type="password" asp-for="NewPassword" required/>

    <label asp-for="ConfirmPassword">Potvrďte heslo</label>
    <input type="password" asp-for="ConfirmPassword" required/>

    <input type="submit" value="Změnit heslo">
</form>
<div asp-validation-summary="ModelOnly"></div>