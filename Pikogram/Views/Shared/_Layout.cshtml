<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Pikogram</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="body">
<!--
Z Reactu a Astra jsem zvyklý dělat si komponentky a skládat je do sebe. Tady to tak jednoduše nejde tak to nechám v layoutu 
Připadám si jak kdybych programoval v pravěku, ani Hot reload půlku času nefunguje a každej novej partial požaduje restart
Jsem rád že se v roce 2026 tohle používá už akorát na backend (kde je to nice)
-->
<header class="header">
    <a asp-controller="Home" asp-action="Index">
        <img src="assets/logo.png" alt="Pikogram" class="header__logo"/>
    </a>
</header>
<main class="main">
    <nav class="nav">
        <a asp-controller="Home" asp-action="Index">Domů</a>
        <a asp-controller="Search" asp-action="Index">Hledat</a>
        <a asp-controller="Privacy" asp-action="Index">Privacy</a>
    </nav>
    @RenderBody()
</main>
<footer class="footer">
    Pikogram 2026 - Nejpoužívanější Instagram klon v Přerově a Ústeckém kraji
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<!-- Vyvíjet se styly v samostatném souboru je neskutečná bolest a některý třídy se mi ani neaplikujou. Má to minimum výhod, takže to budu dělat takhle -->
<style>
    .body {
        
    }

    .header {
        height: var(--header-height);
    }

    .header__logo {
        width: 200px;
    }

    .nav {
        display: flex;
        flex-direction: column;
    }

    .main {
        min-height: calc(100vh - var(--header-height) - var(--footer-height));
    }

    .footer {
        height: var(--footer-height);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
</style>
</body>
</html>